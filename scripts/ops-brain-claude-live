#!/usr/bin/env bash
# Launch Claude Code with the local ops-brain Channel adapter.

set -euo pipefail

SCRIPT_PATH=$(readlink -f -- "${BASH_SOURCE[0]}")
SCRIPT_DIR=$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)
REPO_DIR=$(cd -- "$SCRIPT_DIR/.." && pwd)
ADAPTER="$REPO_DIR/adapters/claude-channel/src/main.js"
OVERLAY_HELPER="$REPO_DIR/scripts/create-claude-channel-overlay.mjs"
PROFILE_HELPER="$REPO_DIR/scripts/ops-brain-client"
TOKEN_FILE="${OPS_BRAIN_AGENT_TOKEN_FILE:-}"
EXPECTED_AGENT="${OPS_BRAIN_EXPECTED_AGENT:-}"
LIVE_URL="${OPS_BRAIN_LIVE_URL:-}"
LABEL="${OPS_BRAIN_LIVE_LABEL:-}"
PROFILE_FILE="${OPS_BRAIN_CLAUDE_PROFILE:-}"
STATE_DIR="${OPS_BRAIN_LIVE_STATE_DIR:-$HOME/.local/state/ops-brain-live}"
PROFILE_ERROR=''
PROFILE_ERROR_DEFERRED=false
CHANNEL_SERVER=ops-brain-live
unset OPS_BRAIN_AGENT_TOKEN

usage() {
    cat <<'EOF'
Usage: ops-brain-claude [--status|--dry-run] [--auto] [--no-live] [--profile FILE] [-- CLAUDE_ARGS...]

Launch Claude Code with ops-brain online delivery enabled for this foreground
session. The launcher uses a private, per-launch Claude config overlay so the
Channel registration cannot affect sibling or wake sessions.

Modes:
  (default)   live is required: any preflight failure exits nonzero
  --auto      main-launcher mode for an interactive shell function. Attended
              TTY launches go live; headless (-p/--print), piped, subcommand,
              --version and --help invocations pass straight through to Claude
              Code untouched. A preflight failure asks the operator on the
              terminal before continuing without live; it never falls back
              silently.
  --no-live   ordinary Claude Code, announced once on stderr
  OPS_BRAIN_LIVE=off in the environment is the same as --no-live.
Any other argument is passed to Claude Code; run `command claude --help` for
its options.

Environment:
  OPS_BRAIN_LIVE_URL          required wss://host/live endpoint
  OPS_BRAIN_AGENT_TOKEN_FILE required identity-bound token file (mode 600 or
                             400); always select the exact Claude identity
  OPS_BRAIN_EXPECTED_AGENT   required exact bound identity, e.g. CC-Stealth
  OPS_BRAIN_LIVE_LABEL        optional non-sensitive peer label
  OPS_BRAIN_CLAUDE_PROFILE    optional profile path; defaults to the Claude
                              profile reported by ops-brain-client
  OPS_BRAIN_LIVE_STATE_DIR    adapter log directory; Claude Code discards this
                              adapter's stderr, so this file is the only record
                              of registration failures

This launcher's own bearer is never placed in Claude's environment, this
adapter's MCP entry, or a command argument -- only the protected token-file path
is passed. The private overlay contains the internal Channel definition plus a
validated theme and literal completed-onboarding flag; an existing user MCP
document is loaded in place with --mcp-config and is never copied. The overlay
is destroyed on exit.
EOF
}

validate_live_url() {
    [[ -n $LIVE_URL ]] || return 1
    node -e '
      let raw = "";
      process.stdin.setEncoding("utf8");
      process.stdin.on("data", chunk => raw += chunk);
      process.stdin.on("end", () => {
        raw = raw.replace(/\n$/, "");
        try {
          const url = new URL(raw);
          const loopback = ["localhost", "127.0.0.1", "[::1]"].includes(url.hostname);
          const valid = !/[\r\n]/.test(raw) && !raw.includes("?") && !raw.includes("#")
            && !url.username && !url.password && !url.search && !url.hash
            && url.pathname === "/live"
            && (url.protocol === "wss:" || (url.protocol === "ws:" && loopback));
          process.exit(valid ? 0 : 1);
        } catch { process.exit(1); }
      });
    ' <<<"$LIVE_URL"
}

mode=run
auto=false
live_requested=true
while (($#)); do
    # In --auto the launcher stands in for the plain client, so every
    # argument other than its own two switches belongs to the client.
    # Recognising anything else here re-creates the -h/--help and Codex
    # --profile collisions one flag at a time; break on the whole class.
    if [[ $auto == true && $1 != --auto && $1 != --no-live ]]; then break; fi
    case "$1" in
        --status) mode=status; shift ;;
        --dry-run) mode=dry; shift ;;
        --auto) auto=true; shift ;;
        --no-live) live_requested=false; shift ;;
        --profile)
            (($# >= 2)) || { echo '--profile requires a path' >&2; exit 2; }
            PROFILE_FILE=$2
            shift 2
            ;;
        -h|--help) usage; exit 0 ;;
        --) shift; break ;;
        *) break ;;
    esac
done
case "${OPS_BRAIN_LIVE:-}" in
    off|0|false) live_requested=false ;;
esac

# Ordinary Claude Code, exactly as if the launcher were not installed. Used
# for every path that must not open a live peer.
run_ordinary() {
    exec claude "$@"
}

# --auto only ever goes live for an attended foreground TUI. Everything a
# script, a wake shim, a pipe, or a subcommand could be doing passes through
# untouched: a headless session cannot render a channel event, and a peer
# without a sink is the "healthy session, absent lane" defect.
# Returns 0 when the launch must stay ordinary.
# Deliberately not run inside $(...): a command substitution makes stdout a
# pipe and would report every launch as unattended.
auto_passthrough_reason() {
    [[ -t 0 && -t 1 ]] || return 0
    local arg
    for arg in "$@"; do
        case "$arg" in
            -p|--print) return 0 ;;
            -v|--version|-h|--help) return 0 ;;
            --) break ;;
        esac
    done
    if (($#)) && [[ $1 != -* ]]; then
        case "$1" in
            mcp|auth|login|logout|doctor|update|install|plugin|plugins|agents|config|setup-token|migrate-installer|remote-control|rc)
                return 0 ;;
        esac
    fi
    return 1
}

if [[ $mode == run && $live_requested == false ]]; then
    echo 'ops-brain live: off (requested); ordinary Claude Code session' >&2
    run_ordinary "$@"
fi
if [[ $mode == run && $auto == true ]] && auto_passthrough_reason "$@"; then
    run_ordinary "$@"
fi

if [[ -f $PROFILE_HELPER ]]; then
    if [[ -z $PROFILE_FILE ]]; then
        PROFILE_FILE=$(node "$PROFILE_HELPER" profile-path claude)
    fi
    if [[ -f $PROFILE_FILE ]]; then
        profile_get() { node "$PROFILE_HELPER" get claude "$1" --profile "$PROFILE_FILE"; }
        read_profile_field() {
            local field=$1 target=$2 value
            if ! value=$(profile_get "$field" 2>&1); then
                PROFILE_ERROR=$value
                return 1
            fi
            printf -v "$target" '%s' "$value"
        }
        profile_live_url=''
        profile_token_file=''
        profile_agent=''
        profile_label=''
        if read_profile_field live_url profile_live_url \
            && read_profile_field credential_file profile_token_file \
            && read_profile_field agent_name profile_agent \
            && read_profile_field label profile_label; then
            [[ -n $LIVE_URL ]] || LIVE_URL=$profile_live_url
            [[ -n $TOKEN_FILE ]] || TOKEN_FILE=$profile_token_file
            [[ -n $EXPECTED_AGENT ]] || EXPECTED_AGENT=$profile_agent
            [[ -n $LABEL ]] || LABEL=$profile_label
        elif [[ $mode == run ]]; then
            PROFILE_ERROR_DEFERRED=true
        elif [[ $mode != status ]]; then
            printf '%s\n' "$PROFILE_ERROR" >&2
            exit 2
        fi
    fi
fi
LABEL="${LABEL:-claude-code}"
# With several attended sessions under one identity, the working directory is
# what tells them apart for a remote sender. The label stays self-reported,
# non-sensitive metadata; peer_id remains the only routing key.
label_with_cwd() {
    local base=$1 dir suffix
    dir=$(basename -- "$PWD")
    suffix=${dir//[^A-Za-z0-9._-]/-}
    suffix=${suffix#.}
    [[ -n $suffix ]] || { printf '%s' "$base"; return; }
    local combined="$base.$suffix"
    printf '%s' "${combined:0:80}"
}
if [[ $mode == run || $mode == dry ]]; then
    LABEL=$(label_with_cwd "$LABEL")
fi

token_status='unset'
if [[ -n $TOKEN_FILE && -f $TOKEN_FILE ]]; then
    token_mode=$(stat -c '%a' "$TOKEN_FILE")
    token_status="present (mode $token_mode)"
fi
url_status='<unset>'
if [[ -n $LIVE_URL ]]; then
    validate_live_url || { echo 'OPS_BRAIN_LIVE_URL must be exact wss://host/live (ws:// only on loopback), without credentials, query, or fragment' >&2; exit 2; }
    url_status=$LIVE_URL
fi

channel_status() {
    [[ -f $OVERLAY_HELPER ]] || { echo 'not ready (overlay helper missing)'; return; }
    echo 'isolated per-launch user scope (ready)'
}

if [[ $mode == status ]]; then
    printf 'adapter: %s\n' "$ADAPTER"
    if [[ -n $PROFILE_ERROR ]]; then
        printf 'profile: %s — not ready (%s)\n' "${PROFILE_FILE:-<unset>}" "${PROFILE_ERROR#ops-brain-client: }"
    elif [[ -n $PROFILE_FILE && ! -f $PROFILE_FILE ]]; then
        printf 'profile: %s — not ready (missing)\n' "$PROFILE_FILE"
    else
        printf 'profile: %s\n' "${PROFILE_FILE:-<unset>}"
    fi
    printf 'url:     %s\n' "$url_status"
    printf 'label:   %s\n' "$LABEL"
    printf 'agent:   %s\n' "${EXPECTED_AGENT:-<unset>}"
    printf 'token:   %s — %s\n' "${TOKEN_FILE:-<unset>}" "$token_status"
    printf 'claude:  %s\n' "$(command -v claude || echo '<missing>')"
    printf 'node:    %s\n' "$(command -v node || echo '<missing>')"
    printf 'channel: %s\n' "$(channel_status)"
    printf 'logs:    %s/claude-adapter.*.log\n' "$STATE_DIR"
    exit 0
fi

# A failed preflight in --auto asks the operator on the terminal; the answer
# is the affirmative choice the rollout contract requires before an ordinary
# session replaces a requested live one. Anything but an explicit yes exits
# nonzero. Outside --auto (the explicit command) the failure is final.
preflight_fail() {
    local reason=$1
    if [[ $auto == true && $mode == run && -t 0 && -t 1 ]]; then
        printf 'ops-brain live: NOT available — %s\n' "$reason" >&2
        local answer=''
        read -r -p 'Continue without live delivery? [y/N] ' answer </dev/tty || answer=''
        case "$answer" in
            y|Y|yes|YES|Yes)
                echo 'ops-brain live: off (operator choice); ordinary Claude Code session' >&2
                run_ordinary "${CLAUDE_ARGS[@]}"
                ;;
        esac
        echo 'ops-brain live: declined ordinary fallback; not launching' >&2
        exit 2
    fi
    printf '%s\n' "$reason" >&2
    exit 2
}
CLAUDE_ARGS=("$@")
if [[ $PROFILE_ERROR_DEFERRED == true ]]; then
    preflight_fail "$PROFILE_ERROR"
fi

validate_live_url || preflight_fail 'OPS_BRAIN_LIVE_URL is required and must be exact wss://host/live (ws:// only on loopback), without credentials, query, or fragment'
[[ -n $TOKEN_FILE ]] || preflight_fail 'OPS_BRAIN_AGENT_TOKEN_FILE is required'
[[ $EXPECTED_AGENT =~ ^[A-Za-z0-9._-]{1,80}$ ]] || preflight_fail 'OPS_BRAIN_EXPECTED_AGENT is required and must be a valid agent slug'
[[ -f $ADAPTER ]] || preflight_fail "adapter missing: $ADAPTER"
[[ -f $OVERLAY_HELPER ]] || preflight_fail "Claude Channel overlay helper missing: $OVERLAY_HELPER"
[[ -f $TOKEN_FILE ]] || preflight_fail "token file missing: $TOKEN_FILE; set OPS_BRAIN_AGENT_TOKEN_FILE to the protected per-agent bearer path"
[[ -L $TOKEN_FILE ]] && preflight_fail "token file must be a regular file, not a symlink: $TOKEN_FILE"
token_mode=$(stat -c '%a' "$TOKEN_FILE")
[[ $token_mode == 600 || $token_mode == 400 ]] || preflight_fail "$TOKEN_FILE has mode $token_mode; require 600 or 400"
command -v node >/dev/null || preflight_fail 'node is required'
command -v claude >/dev/null || { echo 'claude is required' >&2; exit 2; }

token_check=$(<"$TOKEN_FILE")
[[ -n $token_check && $token_check != *$'\n'* && $token_check != *$'\r'* ]] || preflight_fail 'token file must contain exactly one non-empty line'
unset token_check

# Only the state directory path is added here; like the token file, it is a
# path and never a credential value.
server_definition=$(node -e '
  const [adapter, url, label, expectedAgent, tokenFile, stateDir] = process.argv.slice(1);
  process.stdout.write(JSON.stringify({
    command: "node",
    args: [adapter],
    env: {
      OPS_BRAIN_LIVE_URL: url,
      OPS_BRAIN_LIVE_LABEL: label,
      OPS_BRAIN_EXPECTED_AGENT: expectedAgent,
      OPS_BRAIN_AGENT_TOKEN_FILE: tokenFile,
      OPS_BRAIN_LIVE_STATE_DIR: stateDir,
    },
  }));
' "$ADAPTER" "$LIVE_URL" "$LABEL" "$EXPECTED_AGENT" "$TOKEN_FILE" "$STATE_DIR")

if [[ $mode == dry ]]; then
    echo "would launch: CLAUDE_CONFIG_DIR=<private-overlay> claude [--mcp-config <existing-user-config>] --dangerously-load-development-channels server:$CHANNEL_SERVER $*"
    echo "label: $LABEL"
    exit 0
fi

umask 077
# Created only on a real launch so --dry-run stays free of side effects. A
# symlinked state directory is refused for the same reason the Codex launcher
# refuses one: it would redirect adapter output to an attacker-chosen path
# written under the operator's own credentials.
if [[ -L $STATE_DIR || (-e $STATE_DIR && ! -d $STATE_DIR) ]]; then
    echo "state path must be a real directory, not a symlink: $STATE_DIR" >&2
    exit 2
fi
mkdir -p -- "$STATE_DIR"
if [[ -L $STATE_DIR || ! -d $STATE_DIR ]]; then
    echo "state directory validation failed: $STATE_DIR" >&2
    exit 2
fi

RUNTIME_ROOT="${XDG_RUNTIME_DIR:-/tmp}"
if [[ -L $RUNTIME_ROOT || ! -d $RUNTIME_ROOT ]]; then
    echo "runtime path must be a real directory: $RUNTIME_ROOT" >&2
    exit 2
fi
overlay_dir=$(mktemp -d -- "$RUNTIME_ROOT/ops-brain-claude.XXXXXX")
# Invoked by the signal/exit trap below.
# shellcheck disable=SC2317,SC2329
cleanup_overlay() {
    trap - EXIT INT TERM
    [[ $overlay_dir == "$RUNTIME_ROOT"/ops-brain-claude.* && -d $overlay_dir && ! -L $overlay_dir ]] || return 0
    rm -rf -- "$overlay_dir"
}
trap cleanup_overlay EXIT INT TERM

node "$OVERLAY_HELPER" "$overlay_dir" "$CHANNEL_SERVER" "$server_definition"
unset server_definition

# The overlay contains the new Channel definition plus two strictly allowlisted
# display/onboarding preferences. Load the user's real MCP document in place so
# credentials and other servers are never duplicated.
user_mcp_args=()
if [[ -n ${CLAUDE_CONFIG_DIR:-} ]]; then
    user_mcp_config="$CLAUDE_CONFIG_DIR/.claude.json"
else
    user_mcp_config="$HOME/.claude.json"
fi
[[ -f $user_mcp_config ]] && user_mcp_args=(--mcp-config "$user_mcp_config")

# Each launch writes a new adapter log and nothing else prunes them; keep a
# month so a failed bind stays diagnosable without the directory growing for
# the life of the host.
find "$STATE_DIR" -maxdepth 1 -type f -name 'claude-adapter.*.log' -mtime +30 -delete 2>/dev/null || true

printf 'ops-brain live: connecting as %s (label %s); adapter log: %s/claude-adapter.*.log\n' \
    "$EXPECTED_AGENT" "$LABEL" "$STATE_DIR" >&2

set +e
# The launcher's own flags go FIRST. They used to trail "$@", which was
# safe only while the option loop ate a leading `--`; now that the marker
# is the client's (see the --auto passthrough above), anything after it is
# prompt text — so a trailing channel flag would silently not load, while
# this script had already announced a live session. Codex orders it this
# way too, and the --dry-run line above renders this order.
CLAUDE_CONFIG_DIR="$overlay_dir" claude \
    "${user_mcp_args[@]}" \
    --dangerously-load-development-channels "server:$CHANNEL_SERVER" \
    "$@"
exit_status=$?
set -e
exit "$exit_status"
