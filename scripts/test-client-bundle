#!/usr/bin/env bash

set -euo pipefail

SCRIPT_PATH=$(readlink -f -- "${BASH_SOURCE[0]}")
SCRIPT_DIR=$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)
TEST_DIR=$(mktemp -d --tmpdir ops-brain-client-bundle-test.XXXXXX)

cleanup() {
    [[ $(basename -- "$TEST_DIR") == ops-brain-client-bundle-test.* && -d $TEST_DIR && ! -L $TEST_DIR ]] || return 0
    rm -rf -- "$TEST_DIR"
}
trap cleanup EXIT

"$SCRIPT_DIR/build-client-bundle" --version 9.9.9-test --output-dir "$TEST_DIR/dist"
(cd -- "$TEST_DIR/dist" && sha256sum -c ops-brain-client-9.9.9-test.SHA256SUMS)
tar -C "$TEST_DIR" -xzf "$TEST_DIR/dist/ops-brain-client-9.9.9-test.tar.gz"
BUNDLE="$TEST_DIR/ops-brain-client-9.9.9-test"
[[ $(<"$BUNDLE/VERSION") == 9.9.9-test ]]
[[ -d $BUNDLE/adapters/claude-channel/node_modules ]]
[[ -d $BUNDLE/adapters/codex-app-server/node_modules ]]
[[ -f $BUNDLE/LICENSE-MIT && -f $BUNDLE/LICENSE-APACHE ]]
[[ -f $BUNDLE/DEPENDENCIES.json ]]
grep -Fq 'const BUNDLE_BUILD = true' "$BUNDLE/scripts/ops-brain-client"
mkdir -p -- "$TEST_DIR/fake-bin"
printf '%s\n' '#!/usr/bin/env bash' 'exit 97' >"$TEST_DIR/fake-bin/npm"
chmod +x "$TEST_DIR/fake-bin/npm"
install_output=$(PATH="$TEST_DIR/fake-bin:$PATH" "$BUNDLE/scripts/install-ops-brain-client" --bin-dir "$TEST_DIR/bin")
[[ $install_output == *'using ready lockfile-pinned adapter dependencies'* ]]
status=$("$BUNDLE/scripts/install-live-adapters" --status --bin-dir "$TEST_DIR/bin")
[[ $status == *'claude adapter deps: ready'* ]]
[[ $status == *'codex adapter deps:  ready'* ]]
[[ -L $TEST_DIR/bin/ops-brain-client ]]
[[ -L $TEST_DIR/bin/ops-brain-claude ]]
[[ -L $TEST_DIR/bin/ops-brain-codex ]]

# Simulate Windows zip extraction, which materializes npm's .bin symlinks as
# regular files. The manifest must verify those bytes and detect tampering.
mkdir -p -- "$TEST_DIR/windows"
unzip -q "$TEST_DIR/dist/ops-brain-client-9.9.9-test.zip" -d "$TEST_DIR/windows"
WINDOWS_BUNDLE="$TEST_DIR/windows/ops-brain-client-9.9.9-test"
WINDOWS_NODE_WHICH="$WINDOWS_BUNDLE/adapters/claude-channel/node_modules/.bin/node-which"
WINDOWS_NODE_WHICH_TARGET=$(readlink -f -- "$WINDOWS_NODE_WHICH")
rm -- "$WINDOWS_NODE_WHICH"
cp -- "$WINDOWS_NODE_WHICH_TARGET" "$WINDOWS_NODE_WHICH"
[[ -f $WINDOWS_NODE_WHICH && ! -L $WINDOWS_NODE_WHICH ]]
[[ $(node "$WINDOWS_BUNDLE/scripts/ops-brain-client" deps-status claude) == ready ]]
[[ $(node "$WINDOWS_BUNDLE/scripts/ops-brain-client" deps-status codex) == ready ]]
printf '%s\n' 'tampered' >>"$WINDOWS_NODE_WHICH"
[[ $(node "$WINDOWS_BUNDLE/scripts/ops-brain-client" deps-status claude) == missing-or-invalid ]]
[[ $(node "$WINDOWS_BUNDLE/scripts/ops-brain-client" deps-status codex) == ready ]]

# Some ZIP extractors materialize the archive entry itself instead: a regular
# file containing the symlink target text. Verify that exact shape separately.
mkdir -p -- "$TEST_DIR/windows-link-payload"
unzip -q "$TEST_DIR/dist/ops-brain-client-9.9.9-test.zip" -d "$TEST_DIR/windows-link-payload"
PAYLOAD_BUNDLE="$TEST_DIR/windows-link-payload/ops-brain-client-9.9.9-test"
PAYLOAD_NODE_WHICH="$PAYLOAD_BUNDLE/adapters/claude-channel/node_modules/.bin/node-which"
NODE_WHICH_LINK_PAYLOAD=$(readlink -- "$PAYLOAD_NODE_WHICH")
rm -- "$PAYLOAD_NODE_WHICH"
printf '%s' "$NODE_WHICH_LINK_PAYLOAD" >"$PAYLOAD_NODE_WHICH"
[[ -f $PAYLOAD_NODE_WHICH && ! -L $PAYLOAD_NODE_WHICH ]]
[[ $(node "$PAYLOAD_BUNDLE/scripts/ops-brain-client" deps-status claude) == ready ]]
printf 'tampered' >>"$PAYLOAD_NODE_WHICH"
[[ $(node "$PAYLOAD_BUNDLE/scripts/ops-brain-client" deps-status claude) == missing-or-invalid ]]

printf '%s\n' 'tampered' >>"$BUNDLE/adapters/codex-app-server/node_modules/ws/index.js"
[[ $(node "$BUNDLE/scripts/ops-brain-client" deps-status claude) == ready ]]
[[ $(node "$BUNDLE/scripts/ops-brain-client" deps-status codex) == missing-or-invalid ]]
# An entry belonging to no adapter must not sit in unverifiable space.
node -e 'const fs = require("fs"); const f = process.argv[1]; const m = JSON.parse(fs.readFileSync(f, "utf8")); m.entries.push({ path: "TOTAL-JUNK", type: "file", sha256: "0".repeat(64) }); fs.writeFileSync(f, JSON.stringify(m, null, 2) + "\n")' "$BUNDLE/DEPENDENCIES.json"
[[ $(node "$BUNDLE/scripts/ops-brain-client" deps-status claude) == missing-or-invalid ]]
[[ $(node "$BUNDLE/scripts/ops-brain-client" deps-status codex) == missing-or-invalid ]]
rm -- "$BUNDLE/DEPENDENCIES.json"
rm -- "$BUNDLE/VERSION"
[[ $(node "$BUNDLE/scripts/ops-brain-client" deps-status claude) == missing-or-invalid ]]
[[ $(node "$BUNDLE/scripts/ops-brain-client" deps-status codex) == missing-or-invalid ]]
# A planted Cargo.toml must not pass the stamped bundle off as a source checkout.
: >"$BUNDLE/Cargo.toml"
[[ $(node "$BUNDLE/scripts/ops-brain-client" deps-status claude) == missing-or-invalid ]]
[[ $(node "$BUNDLE/scripts/ops-brain-client" deps-status codex) == missing-or-invalid ]]
rm -- "$BUNDLE/Cargo.toml"
echo 'client bundle test passed'
