#!/usr/bin/env bash
# Install the ops-brain foreground client launchers for one Linux user.

set -euo pipefail

SCRIPT_PATH=$(readlink -f -- "${BASH_SOURCE[0]}")
SCRIPT_DIR=$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)
REPO_DIR=$(cd -- "$SCRIPT_DIR/.." && pwd)
BIN_DIR="${HOME}/.local/bin"
MODE=install
INSTALL_DEPS=true

usage() {
    cat <<'EOF'
Usage: install-live-adapters [--status] [--skip-deps] [--bin-dir DIR]

Verifies or installs pinned Node dependencies and links the Claude/Codex
foreground launchers plus ops-brain-client into ~/.local/bin. It never creates,
reads, or copies credentials. Release bundles reuse their included dependencies.

Configure one protected local profile per client with ops-brain-client, or pass
the equivalent environment variables explicitly on each launch.
EOF
}

while (($#)); do
    case "$1" in
        --status) MODE=status; shift ;;
        --skip-deps) INSTALL_DEPS=false; shift ;;
        --bin-dir)
            (($# >= 2)) || { echo '--bin-dir requires a value' >&2; exit 2; }
            BIN_DIR=$2
            shift 2
            ;;
        -h|--help) usage; exit 0 ;;
        *) echo "unknown argument: $1" >&2; usage >&2; exit 2 ;;
    esac
done

CLAUDE_WRAPPER="$REPO_DIR/scripts/ops-brain-claude-live"
CODEX_WRAPPER="$REPO_DIR/scripts/ops-brain-codex-live"
CLIENT_COMMAND="$REPO_DIR/scripts/ops-brain-client"
declare -A INSTALL_TARGETS=(
    [ops-brain-client]="$CLIENT_COMMAND"
    [ops-brain-claude]="$CLAUDE_WRAPPER"
    [ops-brain-codex]="$CODEX_WRAPPER"
    [ops-brain-claude-live]="$CLAUDE_WRAPPER"
    [ops-brain-codex-live]="$CODEX_WRAPPER"
)

node_status=$(command -v node || true)
npm_status=$(command -v npm || true)
node_major=0
if [[ -n $node_status ]]; then
    node_major=$(node -p 'Number(process.versions.node.split(".")[0])' 2>/dev/null || echo 0)
fi

adapter_deps_status() {
    local adapter=$1
    local client=codex
    [[ $adapter == claude-channel ]] && client=claude
    [[ -n $node_status ]] || { echo '<unverified: node missing>'; return; }
    node "$CLIENT_COMMAND" deps-status "$client" 2>/dev/null || echo missing-or-invalid
}

if [[ $MODE == status ]]; then
    printf 'repo:    %s\n' "$REPO_DIR"
    printf 'node:    %s\n' "${node_status:-<missing>}"
    printf 'npm:     %s\n' "${npm_status:-<missing>}"
    printf 'claude:  %s\n' "$(command -v claude || echo '<missing>')"
    printf 'codex:   %s\n' "$(command -v codex || echo '<missing>')"
    printf 'claude adapter deps: %s\n' "$(adapter_deps_status claude-channel)"
    printf 'codex adapter deps:  %s\n' "$(adapter_deps_status codex-app-server)"
    printf 'shell init: %s\n' "$REPO_DIR/scripts/ops-brain-shell-init.sh"
    for name in ops-brain-client ops-brain-claude ops-brain-codex ops-brain-claude-live ops-brain-codex-live; do
        target="$BIN_DIR/$name"
        if [[ -L $target ]]; then
            printf '%-8s %s -> %s\n' "$name:" "$target" "$(readlink -- "$target")"
        elif [[ -e $target ]]; then
            printf '%-8s %s (not a symlink)\n' "$name:" "$target"
        else
            printf '%-8s %s (missing)\n' "$name:" "$target"
        fi
    done
    exit 0
fi

[[ -f $CLAUDE_WRAPPER && -f $CODEX_WRAPPER && -f $CLIENT_COMMAND ]] || {
    echo "launcher files are missing under $REPO_DIR/scripts" >&2
    exit 2
}
[[ -n $node_status && $node_major -ge 22 ]] || {
    echo 'Node.js 22 or newer is required' >&2
    exit 2
}

if [[ -L $BIN_DIR || (-e $BIN_DIR && ! -d $BIN_DIR) ]]; then
    echo "bin path must be a real directory, not a symlink: $BIN_DIR" >&2
    exit 2
fi
mkdir -p -- "$BIN_DIR"
if [[ -L $BIN_DIR || ! -d $BIN_DIR ]]; then
    echo "bin directory validation failed: $BIN_DIR" >&2
    exit 2
fi

declare -a missing_launchers=()
for name in ops-brain-client ops-brain-claude ops-brain-codex ops-brain-claude-live ops-brain-codex-live; do
    target="$BIN_DIR/$name"
    source="${INSTALL_TARGETS[$name]}"
    if [[ -L $target ]]; then
        [[ $(readlink -- "$target") == "$source" ]] || {
            echo "refusing to replace non-owned launcher symlink: $target" >&2
            exit 2
        }
    elif [[ -e $target ]]; then
        echo "refusing to replace non-symlink launcher: $target" >&2
        exit 2
    else
        missing_launchers+=("$name")
    fi
done

claude_deps=$(adapter_deps_status claude-channel)
codex_deps=$(adapter_deps_status codex-app-server)
if [[ $INSTALL_DEPS == true && $claude_deps == ready && $codex_deps == ready ]]; then
    INSTALL_DEPS=false
    echo 'using ready lockfile-pinned adapter dependencies'
fi

if [[ $INSTALL_DEPS == true ]]; then
    [[ -n $npm_status ]] || { echo 'npm is required when adapter dependencies are not ready' >&2; exit 2; }
    for adapter in claude-channel codex-app-server; do
        npm --prefix "$REPO_DIR/adapters/$adapter" ci --ignore-scripts
    done
fi

for name in "${missing_launchers[@]}"; do
    target="$BIN_DIR/$name"
    source="${INSTALL_TARGETS[$name]}"
    ln -s -- "$source" "$target"
done

printf 'installed ops-brain client commands in %s\n' "$BIN_DIR"
printf '%s\n' 'configure profiles with ops-brain-client configure claude|codex, then run ops-brain-claude or ops-brain-codex'
printf 'to make plain claude and codex launches go live from an interactive shell, add to ~/.bashrc or ~/.zshrc:\n  . %q\n' "$REPO_DIR/scripts/ops-brain-shell-init.sh"
